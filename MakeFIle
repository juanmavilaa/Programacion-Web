APP_NAME := reps
API_URL := http://localhost:8080

.PHONY: all generate build up down run test clean

all: build

# Genera el código de acceso a datos con sqlc
generate:
	@sqlc generate

# Compila el binario de la aplicación
build: generate
	@mkdir -p tmp
	@go build -o tmp/$(APP_NAME) .

# Levanta la base y la API en segundo plano y espera a que la API responda
up:
	@docker compose up -d --build
	@echo "Esperando a que la API este disponible..."
	@for i in $$(seq 1 60); do \
		curl -s -o /dev/null $(API_URL)/clients && echo "API lista en $(API_URL)" && exit 0; \
		sleep 1; \
	done; \
	echo "La API no respondio a tiempo"; docker compose logs api; exit 1

# Detiene los contenedores y borra los volúmenes
down:
	@docker compose down -v

# Levanta la base y la API en primer plano mostrando los logs
run:
	@docker compose up --build

# Tareas previas, tests de la API (Hurl), tests de persistencia (go test) y limpieza
test: down build up
	@status=0; \
	echo "Ejecutando tests de la API (Hurl)..."; \
	hurl --test requests.hurl || status=1; \
	echo "Ejecutando tests de persistencia (go test)..."; \
	go test -v -count=1 ./... || status=1; \
	docker compose down -v; \
	exit $$status

# Limpia contenedores, volúmenes y artefactos de compilación
clean: down
	@rm -rf tmp