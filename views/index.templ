package views

import db "reps/db/sqlc"

templ IndexPage(clients []db.Client, workouts []db.Workout) {
	@Layout("Reps") {
		<div id="mensaje"></div>
		<section>
			<h2>Clientes</h2>
			<div id="client-form">
				@ClientForm()
			</div>
			@ClientList(clients)
		</section>
		<section>
			<h2>Entrenamientos</h2>
			<div id="workout-form">
				@WorkoutForm(clients)
			</div>
			@WorkoutList(workouts, clients)
		</section>
	}
}
