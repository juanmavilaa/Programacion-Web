package views

import (
	db "reps/db/sqlc"
	"strconv"
)

templ ClientForm() {
	<form method="post" action="/clients">
		<label for="client-name">Nombre</label>
		<input type="text" id="client-name" name="name" required/>
		<label for="client-email">Email</label>
		<input type="email" id="client-email" name="email" required/>
		<button type="submit">Agregar cliente</button>
	</form>
}

templ WorkoutForm(clients []db.Client) {
	if len(clients) == 0 {
		<p>Para cargar un entrenamiento primero hay que agregar un cliente.</p>
	} else {
		<form method="post" action="/workouts">
			<label for="workout-client">Cliente</label>
			<select id="workout-client" name="client_id" required>
				for _, client := range clients {
					<option value={ strconv.Itoa(int(client.ID)) }>{ client.Name }</option>
				}
			</select>
			<label for="workout-exercise">Ejercicio</label>
			<input type="text" id="workout-exercise" name="exercise" required/>
			<div class="grid">
				<label for="workout-sets">
					Series
					<input type="number" id="workout-sets" name="sets" min="1" required/>
				</label>
				<label for="workout-repetitions">
					Repeticiones
					<input type="number" id="workout-repetitions" name="repetitions" min="1" required/>
				</label>
				<label for="workout-weight">
					Peso (kg)
					<input type="number" id="workout-weight" name="weight" min="0" step="0.01" required/>
				</label>
			</div>
			<button type="submit">Agregar entrenamiento</button>
		</form>
	}
}
