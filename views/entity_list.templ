package views

import (
	"fmt"
	db "reps/db/sqlc"
	"strconv"
)

templ ClientList(clients []db.Client) {
	<div id="client-list" class="overflow-auto">
		if len(clients) == 0 {
			<p>Todavía no hay clientes cargados.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Nombre</th>
						<th>Email</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, client := range clients {
						<tr>
							<td>{ client.Name }</td>
							<td>{ client.Email }</td>
							<td>
								<button class="secondary" hx-delete={ fmt.Sprintf("/clients/%d", client.ID) } hx-target="closest tr" hx-swap="outerHTML" hx-confirm="¿Borrar este cliente?">Borrar</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ WorkoutList(workouts []db.Workout, clients []db.Client) {
	<div id="workout-list" class="overflow-auto">
		if len(workouts) == 0 {
			<p>Todavía no hay entrenamientos cargados.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Cliente</th>
						<th>Ejercicio</th>
						<th>Series</th>
						<th>Rep.</th>
						<th>Peso</th>
						<th>Fecha</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, workout := range workouts {
						<tr>
							<td>{ clientName(clients, workout.ClientID) }</td>
							<td>{ workout.Exercise }</td>
							<td>{ strconv.Itoa(int(workout.Sets)) }</td>
							<td>{ strconv.Itoa(int(workout.Repetitions)) }</td>
							<td>{ workout.Weight } kg</td>
							<td>{ workout.CreatedAt.Format("02/01/2006") }</td>
							<td>
								<button class="secondary" hx-delete={ fmt.Sprintf("/workouts/%d", workout.ID) } hx-target="closest tr" hx-swap="outerHTML" hx-confirm="¿Borrar este entrenamiento?">Borrar</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}
